#FRONTEND
API_BASE_URL=replace-with-api-base-url
SESSION_SECRET=replace-with-a-long-random-secret-for-the-frontend


#DJANGO
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
# uhc-api is needed so the frontend container can call the API by its service name
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,uhc-api


#POSTGRES
POSTGRES_DB=replace-with-db-name
POSTGRES_USER=replace-with-db-username
POSTGRES_PASSWORD=replace-with-db-password

DB_HOST=replace-with-your-docker-db-service-name
DB_PORT=replace-with-your-docker-db-public-host

CORS_ALLOWED_ORIGINS=http://localhost:3000

SEED_ADMIN_USERNAME=replace-with-your-admin-username
SEED_ADMIN_PASSWORD=replace-with-your-admin-password


#DHIS2

# DHIS2 public demo connection
DHIS2_BASE_URL=replace-with-dhis2-public-demo-api-url
DHIS2_USERNAME=replace-with-dhis2-public-demo-api-username
DHIS2_PASSWORD=replace-with-dhis2-public-demo-api-password

# Network configuration
DHIS2_CONNECT_TIMEOUT=5
DHIS2_READ_TIMEOUT=60

# Use the generic dx name because our measure is a data element
# DHIS2's dx dimension also accepts data elements.
DHIS2_DX_IDS=replace-with-data-element-id

# Verified annual reporting period
DHIS2_PERIODS=replace-with-verified-period

# The 12 directly matched district organisation units
DHIS2_ORG_UNIT_IDS=comma-separated-list-of-verified-district-organization unit codes

# Worker behaviour
ACQUISITION_POLL_SECONDS=3
DHIS2_MAX_ATTEMPTS=3
DHIS2_RETRY_BACKOFF_SECONDS=2

#FHIR 
#The base url must be https://
FHIR_CANONICAL_BASE_URL=replace-with-your-controlled-fhir-base-url

