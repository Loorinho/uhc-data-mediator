
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
# uhc-api is needed so the frontend container can call the API by its service name
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,uhc-api

POSTGRES_DB=uhc_mediator
POSTGRES_USER=uhc_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password

DB_HOST=uhc-db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
